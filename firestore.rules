rules_version = '2';

// Security rules for the pubquiz. The UI is not trusted: everything a player
// must not see or do is blocked here.
//
// Replace <ADMIN_UID> with the UID of the admin account (see README.md).
// While the placeholder is still there, nobody is admin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == '<ADMIN_UID>';
    }

    function gameState() {
      return get(/databases/$(database)/documents/game/state).data;
    }

    // Public game state: phase, round, question label, deadline and the
    // public payload. Never contains answers.
    match /game/state {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Full quiz including answers, the people with their aliases, and the
    // score log: admin only.
    match /quiz/{docId} {
      allow read, write: if isAdmin();
    }
    match /people/{personId} {
      allow read, write: if isAdmin();
    }
    match /scoreEntries/{entryId} {
      allow read, write: if isAdmin();
    }

    // A group is identified by its anonymous auth UID.
    match /groups/{uid} {
      allow read, write: if isAdmin();

      allow get: if signedIn() && request.auth.uid == uid;

      // Created together (one batch) with the groupNames claim below.
      allow create: if signedIn()
        && request.auth.uid == uid
        && gameState().registrationOpen == true
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'createdAt', 'lastSeen', 'disqualified'])
        && request.resource.data.keys().hasAll(['name', 'nameKey', 'createdAt', 'lastSeen', 'disqualified'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.nameKey is string
        && request.resource.data.disqualified == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time
        && getAfter(/databases/$(database)/documents/groupNames/$(request.resource.data.nameKey)).data.uid == uid;

      // Heartbeat only.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
    }

    // Claim on a normalised group name, so names stay unique. The claim must
    // point at the group that is created in the same batch, which also means
    // one group cannot claim more than one name.
    match /groupNames/{nameKey} {
      allow read, write: if isAdmin();

      allow get: if signedIn();

      allow create: if signedIn()
        && nameKey.matches('^[a-z0-9]{2,24}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.auth.uid)).data.nameKey == nameKey;
    }

    // Answers: create once, never change. Only for the item that is open
    // right now and only before the deadline (2 seconds of slack).
    match /answers/{answerId} {
      allow read, write: if isAdmin();

      // By id rather than by content, so that asking for an answer that
      // does not exist yet is allowed too.
      allow get: if signedIn() && answerId.matches('.*_' + request.auth.uid + '$');
      allow list: if signedIn() && resource.data.groupId == request.auth.uid;

      allow create: if signedIn()
        && gameState().phase == 'question_open'
        && answerId == gameState().itemId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['groupId', 'itemId', 'value', 'submittedAt'])
        && request.resource.data.keys().hasAll(['groupId', 'itemId', 'value', 'submittedAt'])
        && request.resource.data.groupId == request.auth.uid
        && request.resource.data.itemId == gameState().itemId
        && request.resource.data.submittedAt == request.time
        && validAnswerValue(request.resource.data.value)
        && (gameState().deadline == null
            || request.time < gameState().deadline + duration.value(2, 's'))
        && get(/databases/$(database)/documents/groups/$(request.auth.uid)).data.disqualified == false;
    }

    function validAnswerValue(value) {
      return (value is string && value.size() <= 100)
        || (value is map && value.size() <= 40);
    }

    // Tab-leave reports. Groups can only write their own, only admin reads.
    match /events/{eventId} {
      allow read, write: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'type', 'at', 'awayMs', 'itemId', 'phase'])
        && request.resource.data.groupId == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.at == request.time;
    }
  }
}
